# =============================================================================
#  APP Settings
# =============================================================================
APP_NAME="AI Legal API"
APP_VERSION="0.0.1"
APP_ENV="development"
APP_PORT=8000
APP_BASE_URL="http://localhost:8000"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8080"

# =============================================================================
# AI
# =============================================================================
GOOGLE_API_KEY=""

# =============================================================================
# Database
# =============================================================================
DB_HOST="localhost"
DB_USER=admin
DB_PASS=""
DB_NAME=dev_ai_legal
DB_PORT=5432

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
RATELIMIT_REDIS_DB=0

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET_KEY="your-super-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=5
# =============================================================================
# AI: Google Gemini (spec Section 12). All have defaults in config/settings.py.
# =============================================================================
LLM_ENABLED=true
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# =============================================================================
# Vectors, retrieval and replay
# =============================================================================
# Chroma holds the dense vectors; BM25 runs in-process; the two are fused with RRF.
# Embedded (persistent) under CHROMA_PERSIST_DIR unless CHROMA_HOST points at a Chroma server.
CHROMA_PERSIST_DIR=.chroma
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_SSL=false
CHROMA_COLLECTION=unit100_chunks
KB_TOP_K=8
KB_CONTEXT_CHUNKS=5
KB_MIN_SCORE=0.35
REPLAY_SECONDS_PER_HOUR=2.0
# Demo data package (seed JSON, replay files, corpus, golden sets, seed.sql)
DEMO_DATA_DIR=safeloop-demo-data/data
