{
  "status": 1,
  "data": {
    "version": "v1",
    "status": "under_review",
    "label": "Illustrative rules, pending engineer approval",
    "likelihood_cap": 5,
    "bands": [
      {
        "name": "low",
        "min": 1,
        "max": 4
      },
      {
        "name": "medium",
        "min": 5,
        "max": 9
      },
      {
        "name": "high",
        "min": 10,
        "max": 14
      },
      {
        "name": "extreme",
        "min": 15,
        "max": 25
      }
    ],
    "rules": [
      {
        "id": "R-L-01",
        "text": "Cause asset Degraded: likelihood +1",
        "when": {
          "cause_asset_band": "degraded"
        },
        "effect": {
          "likelihood_delta": 1
        }
      },
      {
        "id": "R-L-02",
        "text": "Cause asset Critical: likelihood +2 (replaces R-L-01)",
        "when": {
          "cause_asset_band": "critical"
        },
        "effect": {
          "likelihood_delta": 2
        },
        "replaces": "R-L-01"
      },
      {
        "id": "R-S-01",
        "text": "A credited BPCS safeguard depends on a Degraded or Critical asset: credit removed, likelihood +1",
        "when": {
          "safeguard_type": "bpcs",
          "any_dependency_band_in": [
            "degraded",
            "critical"
          ]
        },
        "effect": {
          "likelihood_delta": 1,
          "remove_credit": true
        },
        "applies_once_per_row": true
      },
      {
        "id": "R-P-01",
        "text": "Asset causes a row with severity >= 4: alert line tightens to alert_high_tightened",
        "when": {
          "cause_of_row_with_severity_gte": 4
        },
        "effect": {
          "tighten_alert": true
        }
      }
    ]
  },
  "metadata": null,
  "message": "Success"
}
